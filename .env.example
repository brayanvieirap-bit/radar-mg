# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

# Use a "Project URL"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave "anon public" — NUNCA a "service_role" aqui.
# A service_role ignora o RLS e não pode ficar exposta no frontend.
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
